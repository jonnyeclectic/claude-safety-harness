#!/usr/bin/env bash
# claudex — launch Claude Code in a sandboxed bypassPermissions ("YOLO") session.
#
#   claudex            sandboxed bypass in the current dir; writes limited to the
#                      project + temp (kernel-enforced); network open.
#   claudex --strict   same, plus: NO subprocess network egress, secret files
#                      (~/.ssh, ~/.aws, ...) hidden, secret env vars scrubbed.
#   claudex --account claude-personal
#                      run as the account whose config dir is ~/.claude-personal
#                      (sets CLAUDE_CONFIG_DIR); `--account claude` is the default
#                      account (unsets it). Without the flag, an inherited
#                      CLAUDE_CONFIG_DIR is left alone.
#
# All other arguments are passed straight through to `claude`.
#
# The OS sandbox is the hard wall (Seatbelt on macOS / bubblewrap on Linux); the
# bundled plugin's PreToolUse hooks add the advisory layer + test nudge on top.
# Trusted sibling roots from ~/.claude/harness-trusted-roots.txt are made
# writable in the sandbox and passed as --add-dir.
set -euo pipefail

HARNESS_DIR="${CLAUDEX_HARNESS_DIR:-$HOME/.claude/harness}"
TRUSTED_ROOTS="${CLAUDEX_TRUSTED_ROOTS:-$HOME/.claude/harness-trusted-roots.txt}"

# --- parse args: consume --strict/--account, pass the rest through ----------
strict=0
account=""
account_set=0
pass_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --strict)    strict=1 ;;
    --account=*) account="${1#--account=}"; account_set=1 ;;
    --account)
      if [ $# -lt 2 ]; then
        echo "claudex: --account needs a name, e.g. --account claude-personal" >&2
        exit 2
      fi
      account="$2"
      account_set=1
      shift
      ;;
    *)           pass_args+=("$1") ;;
  esac
  shift
done

# --- pick the account: its config dir holds the login, plugins, history -----
# Only `claude` or `claude-<name>` so the flag can't point claude at an
# arbitrary dotdir, and the dir must already exist: a typo would otherwise
# start a fresh, logged-out config instead of failing here.
#
# With CLAUDE_CONFIG_DIR set, Claude Code "keys the macOS Keychain entry to that
# directory too, so a session with a different CLAUDE_CONFIG_DIR reads a
# different entry" (docs: Authentication > Credential management). The key is
# the literal string, and the default login is used only when the variable is
# unset, so:
#   - the default account unsets it. CLAUDE_CONFIG_DIR=$HOME/.claude is a
#     *different*, empty login (`claude auth status`: loggedIn false).
#   - a named account gets exactly "$HOME/.<name>", no realpath or trailing
#     slash, to match what a `CLAUDE_CONFIG_DIR=$HOME/.<name> claude` alias
#     stored at login; and the name must match the dir entry's exact case,
#     since macOS's case-insensitive APFS would let `-d` accept a case typo
#     that then reads a logged-out entry on top of the real account's files.
if [ "$account_set" -eq 1 ]; then
  case "$account" in
    */*) account_ok=0 ;;
    claude|claude-*) account_ok=1 ;;
    *) account_ok=0 ;;
  esac
  if [ "$account_ok" -eq 0 ]; then
    echo "claudex: --account '$account' is not an account name (claude or claude-<name>)." >&2
    exit 2
  fi
  if [ "$account" = "claude" ]; then
    unset CLAUDE_CONFIG_DIR
  else
    account_found=0
    for d in "$HOME"/.claude-*; do
      if [ -d "$d" ] && [ "${d##*/}" = ".$account" ]; then
        account_found=1
      fi
    done
    if [ "$account_found" -eq 0 ]; then
      echo "claudex: --account $account: no config dir at $HOME/.$account" >&2
      exit 1
    fi
    export CLAUDE_CONFIG_DIR="$HOME/.$account"
  fi
fi
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  account_desc="$CLAUDE_CONFIG_DIR"
else
  account_desc="$HOME/.claude (default)"
fi

if [ "$strict" -eq 1 ]; then
  template="$HARNESS_DIR/sandbox.strict.json"
else
  template="$HARNESS_DIR/sandbox.base.json"
fi

compose="$HARNESS_DIR/compose-settings.py"
for f in "$template" "$compose"; do
  if [ ! -f "$f" ]; then
    echo "claudex: missing $f — run ./install.sh first." >&2
    exit 1
  fi
done

if ! command -v claude >/dev/null 2>&1; then
  echo "claudex: 'claude' not found on PATH." >&2
  exit 1
fi

# --- compose effective settings + collect trusted roots for --add-dir -------
workdir="$(mktemp -d "${TMPDIR:-/tmp}/claudex.XXXXXX")"
cleanup() { rm -rf "$workdir"; }
trap cleanup EXIT INT TERM
settings_file="$workdir/settings.json"

add_dirs=()
roots_arg="$TRUSTED_ROOTS"
[ -f "$roots_arg" ] || roots_arg="NONE"
# Run compose through a file, not a process substitution: it exits 4 when the
# project's own settings widen the sandbox, and a `done < <(...)` pipeline
# throws that status away -- claudex would launch a session whose wall the repo
# had already opened. The 4 is passed straight through, so a caller can tell it
# from claudex's own exit 1 ("not installed", "claude not on PATH").
roots_out="$workdir/trusted-roots.txt"
# CLAUDEX_PROJECT_DIR is pinned, not inherited: a hostile repo gets to set
# environment variables too (direnv, a .envrc), and pointing the check at an
# empty directory would be the cheapest way past it.
CLAUDEX_PROJECT_DIR="$PWD" CLAUDEX_STRICT="$strict" \
  python3 "$compose" "$template" "$roots_arg" "$settings_file" > "$roots_out" || exit $?
while IFS= read -r d; do
  [ -n "$d" ] && add_dirs+=(--add-dir "$d")
done < "$roots_out"

# --- keep the caller's Anthropic auth context reaching `claude` -------------
# Terminal integrations put their own shim in front of `claude`, and some of
# them scrub auth on the way through: cmux, for one, unsets ANTHROPIC_API_KEY,
# ANTHROPIC_MODEL and the Bedrock/Vertex selectors before exec'ing the real
# CLI so a fresh pane can't inherit a stale key. Launched from such a terminal
# claudex would hand `claude` an environment with the auth the user set
# stripped back out, and the session would quietly fall back to whatever
# credentials are cached on disk — a wrong-account run or a 401 with nothing
# on screen explaining why. So: if the caller actually set auth context, opt
# into the wrapper's documented preserve hatch, and always say out loud which
# source won. CLAUDEX_NO_AUTH_PASSTHROUGH=1 defers to the wrapper's scrub.
auth_env_set=""
cred_env_set=""
for v in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN \
         CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY \
         ANTHROPIC_PROFILE \
         ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_BASE_URL; do
  if [ -n "${!v:-}" ]; then
    auth_env_set="${auth_env_set:+$auth_env_set }$v"
    case "$v" in
      ANTHROPIC_MODEL|ANTHROPIC_SMALL_FAST_MODEL|ANTHROPIC_BASE_URL) ;;
      *) cred_env_set="${cred_env_set:+$cred_env_set }$v" ;;
    esac
  fi
done
# Federation credentials only apply when both halves are set.
if [ -n "${ANTHROPIC_FEDERATION_RULE_ID:-}" ] && [ -n "${ANTHROPIC_ORGANIZATION_ID:-}" ]; then
  auth_env_set="${auth_env_set:+$auth_env_set }ANTHROPIC_FEDERATION_RULE_ID+ANTHROPIC_ORGANIZATION_ID"
  cred_env_set="${cred_env_set:+$cred_env_set }ANTHROPIC_FEDERATION_RULE_ID+ANTHROPIC_ORGANIZATION_ID"
fi

# Credentials in the environment outrank a config dir's cached login, so
# --account alone would still bill whatever key is exported: the exact
# wrong-account run the flag exists to prevent, with nothing on screen.
if [ "$account_set" -eq 1 ] && [ -n "$cred_env_set" ]; then
  echo "claudex: warning: --account $account uses the login cached in $account_desc, but" >&2
  echo "        $cred_env_set in your environment takes precedence over it. Unset to use the account." >&2
fi

if [ -n "$auth_env_set" ]; then
  auth_source="env ($auth_env_set)"
  if [ "${CLAUDEX_NO_AUTH_PASSTHROUGH:-0}" != "1" ]; then
    export CMUX_PRESERVE_CLAUDE_AUTH_SELECTION_ENV=1
  fi
else
  auth_source="cached login (no auth env set)"
fi

# An sk-ant-api03- value in CLAUDE_CODE_OAUTH_TOKEN is the one auth mistake
# that fails *after* a successful launch, as a bare 401 mid-session: the var
# takes an OAuth token (sk-ant-oat01-), and an API key belongs in
# ANTHROPIC_API_KEY. Cheap to spot here, expensive to debug from the error.
case "${CLAUDE_CODE_OAUTH_TOKEN:-}" in
  sk-ant-api03-*)
    echo "claudex: warning: CLAUDE_CODE_OAUTH_TOKEN holds an sk-ant-api03- API key, not an" >&2
    echo "        OAuth token (sk-ant-oat01-). Claude will 401. Put API keys in ANTHROPIC_API_KEY." >&2
    ;;
esac

# --- announce the active profile (to stderr, so -p stdout stays clean) ------
if [ "$strict" -eq 1 ]; then
  echo "claudex: STRICT — sandbox on; subprocess network DISABLED; secrets hidden; writes → project+temp." >&2
else
  echo "claudex: sandbox on; writes → project+temp (+trusted roots); network open. Use --strict to lock down." >&2
fi
echo "claudex: account → $account_desc" >&2
echo "claudex: auth → $auth_source" >&2

# Run as a child (not exec) so the temp settings dir is cleaned up on exit.
claude --dangerously-skip-permissions \
       --settings "$settings_file" \
       "${add_dirs[@]+"${add_dirs[@]}"}" \
       "${pass_args[@]+"${pass_args[@]}"}"
