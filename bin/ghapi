#!/usr/bin/env python3
"""`gh api`-compatible GitHub client that works inside the OS sandbox.

Why this exists: under Seatbelt, `gh` cannot make *any* HTTPS request. Go's
macOS TLS stack verifies certificates by calling into the Security framework,
which reaches `trustd` over XPC -- a mach lookup the sandbox denies. Every
request dies with:

    tls: failed to verify certificate: x509: OSStatus -26276   (errSecInternalComponent)

`gh auth status` misreports that as "The token in GITHUB_TOKEN is invalid",
which sends you hunting for a credential problem that isn't there. The token is
fine; the verifier is unreachable. No env var fixes it -- SSL_CERT_FILE and
GODEBUG=x509usefallbackroots=1 are both ignored on darwin, because Go always
uses the platform verifier when RootCAs is nil. It is not specific to `gh`:
any Go binary doing TLS (docker, terraform, kubectl) fails the same way here.

curl is unaffected -- it verifies against OpenSSL's CA bundle in-process and
never talks to trustd -- so this reimplements the subset of `gh api` that
matters, with curl as the transport and Python for parsing/pagination.

Python's own urllib is *not* usable as the transport here, despite its TLS
working fine: responses over ~5KB come back truncated (IncompleteRead, at a
different offset each run) because the sandbox's HTTP/1.1 proxy hangs up early.
curl negotiates HTTP/2 and returns the full body every time. If you write your
own helper, use curl and don't trust urllib for anything large.

Flag-compatible with `gh api` where it counts, so existing habits transfer:

    ghapi auth status
    ghapi user
    ghapi user -i                       # include response headers (scopes, rate limit)
    ghapi repos/{owner}/{repo}/pulls --paginate --jq '.[].title'
    ghapi -X POST repos/o/r/issues -f title='Bug' -F labels[]=bug
    ghapi graphql -f query='{viewer{login}}'

`-f` and `-F` are NOT interchangeable, and the difference is easy to lose:

    -f k=v        literal string, always. `-f n=1` sends "1", not 1.
    -F k=v        typed: 1 -> 1, true -> true, and **@file reads the file**.
    -F k=@-       read the value from stdin.
    --input f     send a whole JSON body from a file (or `-` for stdin).

Only `-F` expands `@file`. `-f body=@notes.md` would post the literal string
"@notes.md" -- and GitHub accepts that request, drops the unknown value, and
returns 200, so nothing anywhere says the body never arrived. ghapi refuses it
instead, and likewise refuses a field spec with no `=` at all (`-f body@notes.md`
otherwise becomes a field NAMED "body@notes.md" with an empty value).

Round-tripping a field through a file is NOT byte-exact: `jq -r` terminates its
output with a newline, so `ghapi ... --jq .body > b.md` then `-F body=@b.md`
writes the body back one newline longer each time. Strip exactly one trailing
newline if you need the value preserved verbatim.

{owner}/{repo} placeholders are filled from the `origin` remote, as gh does.
Not implemented: the non-api subcommands (`gh pr create`, `gh run watch`, ...).
Those are a much larger surface; use the REST endpoints directly.
"""
import json
import os
import re
import subprocess
import sys
import tempfile

API = "https://api.github.com"
USAGE = ("usage: ghapi [-X METHOD] [-f k=v] [-F k=v] [-H hdr] [-i] [--paginate] "
         "[--jq expr] [--input f] <endpoint>\n"
         "       ghapi auth status")


def die(msg, code=1):
    print(f"ghapi: {msg}", file=sys.stderr)
    sys.exit(code)


def token():
    for var in ("GITHUB_TOKEN", "GH_TOKEN"):
        if os.environ.get(var):
            return os.environ[var]
    die("no token: set GITHUB_TOKEN or GH_TOKEN")


def repo_slug():
    """owner/repo from the origin remote, for {owner}/{repo} placeholders."""
    try:
        url = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        die("cannot resolve {owner}/{repo}: no git origin remote here")
    m = re.search(r"[:/]([^/:]+)/([^/]+?)(?:\.git)?$", url)
    if not m:
        die(f"cannot parse owner/repo from origin url: {url}")
    return m.group(1), m.group(2)


def read_at_file(path, flag):
    """Read the file an `@path` value names (`@-` = stdin), or die cleanly.

    Without this an unreadable path surfaced as a bare Python traceback, which
    reads like a bug in ghapi rather than a typo in the command.
    """
    if path == "-":
        return sys.stdin.read()
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError as e:
        die(f"{flag}: cannot read @{path}: {e.strerror}")


def typed(value, flag):
    """`-F` semantics: JSON-ish scalars stay typed, @file reads a file."""
    if value.startswith("@"):
        return read_at_file(value[1:], flag)
    if value in ("true", "false", "null"):
        return {"true": True, "false": False, "null": None}[value]
    try:
        return int(value)
    except ValueError:
        pass
    try:
        return float(value)
    except ValueError:
        return value


def raw(value, key, flag):
    """`-f` semantics: the value is sent as a literal string, exactly as gh does.

    With one guard. gh happily sends `-f body=@notes.md` as the 10-character
    string "@notes.md", and GitHub ACCEPTS that request and ignores the field --
    so the call succeeds, exits 0, and the thing you meant to send simply isn't
    there. That is how a PR gets opened with a null body and nothing anywhere
    says so. When the text after `@` names a file that exists, refuse and point
    at -F.

    A leading `@` that is NOT a path stays a literal, because that is exactly
    what -f is for: `-f body='@octocat can you review'` is a real GitHub
    mention, not a mistake.
    """
    if value.startswith("@"):
        path = value[1:]
        if path == "-" or os.path.exists(path):
            die(f"{flag} sends values literally, so `{key}={value}` would post "
                f"the string {value!r} rather than that file's contents.\n"
                f"       to send the file:     -F {key}=@{path}\n"
                f"       to send a literal @:  --input with a full JSON body")
    return value


def add_field(fields, key, value):
    """`key[]=v` accumulates into a list, matching gh."""
    if key.endswith("[]"):
        fields.setdefault(key[:-2], []).append(value)
    else:
        fields[key] = value


def parse_args(argv):
    a = {"method": None, "endpoint": None, "fields": {}, "headers": {},
         "paginate": False, "jq": None, "body": None, "include": False}
    i = 0
    while i < len(argv):
        arg = argv[i]

        def nxt(flag):
            nonlocal i
            if i + 1 >= len(argv):
                die(f"{flag} needs a value")
            i += 1
            return argv[i]

        if arg in ("-X", "--method"):
            a["method"] = nxt(arg).upper()
        elif arg in ("-f", "--raw-field", "-F", "--field"):
            spec = nxt(arg)
            k, eq, v = spec.partition("=")
            # Without this, `-f body@notes.md` (a mistyped `=`) partitions into
            # the key "body@notes.md" and an empty value: a field GitHub does not
            # recognize, silently drops, and still returns 200 for. The request
            # looks like it worked and the field is just missing.
            if not eq:
                die(f"{arg}: missing '=' in field {spec!r} "
                    f"(expected {arg} key=value)")
            add_field(a["fields"], k,
                      raw(v, k, arg) if arg in ("-f", "--raw-field")
                      else typed(v, arg))
        elif arg in ("-H", "--header"):
            k, _, v = nxt(arg).partition(":")
            a["headers"][k.strip()] = v.strip()
        elif arg == "--input":
            a["body"] = read_at_file(nxt(arg), arg)
        elif arg == "--paginate":
            a["paginate"] = True
        elif arg in ("-i", "--include"):
            a["include"] = True
        elif arg in ("-q", "--jq"):
            a["jq"] = nxt(arg)
        elif arg in ("-h", "--help"):
            print(USAGE)
            print(__doc__)
            sys.exit(0)
        elif arg.startswith("-"):
            die(f"unknown flag {arg}\n{USAGE}")
        elif a["endpoint"] is None:
            a["endpoint"] = arg
        else:
            die(f"unexpected argument {arg}\n{USAGE}")
        i += 1

    if not a["endpoint"]:
        die(USAGE)
    return a


def build_url(endpoint):
    if endpoint.startswith(("http://", "https://")):
        return endpoint
    if "{owner}" in endpoint or "{repo}" in endpoint:
        owner, repo = repo_slug()
        endpoint = endpoint.replace("{owner}", owner).replace("{repo}", repo)
    return f"{API}/{endpoint.lstrip('/')}"


def request(url, method, headers, body):
    """Returns (body_text, response_headers). Exits non-zero on HTTP/curl error.

    The token goes in a curl --config file rather than argv, so it never shows
    up in `ps` output.
    """
    hdrs = {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if body:
        hdrs["Content-Type"] = "application/json"
    hdrs.update(headers)

    with tempfile.TemporaryDirectory() as td:
        cfg = os.path.join(td, "curlrc")
        head_path = os.path.join(td, "head")
        body_path = os.path.join(td, "body")
        with open(cfg, "w") as f:
            f.write(f'header = "Authorization: Bearer {token()}"\n')

        cmd = ["curl", "-sS", "--config", cfg, "--max-time", "60",
               "-X", method, "-D", head_path, "-o", body_path,
               "-w", "%{http_code}", "--user-agent", "ghapi-sandbox-shim"]
        for k, v in hdrs.items():
            cmd += ["-H", f"{k}: {v}"]
        if body:
            cmd += ["--data-binary", "@-"]
        cmd.append(url)

        p = subprocess.run(cmd, input=body, capture_output=True)
        if p.returncode != 0:
            die(f"curl failed ({p.returncode}) on {method} {url}\n"
                f"{p.stderr.decode(errors='replace').strip()}")

        status = p.stdout.decode(errors="replace").strip()
        with open(body_path, encoding="utf-8", errors="replace") as f:
            text = f.read()
        with open(head_path, encoding="utf-8", errors="replace") as f:
            raw_head = f.read()

    if not status.startswith("2"):
        die(f"HTTP {status} on {method} {url}\n{text.strip()}")

    return text, final_headers(raw_head)


def final_headers(raw_head):
    """Last header block from curl -D.

    Through the sandbox proxy curl emits two blocks -- the CONNECT tunnel's
    `HTTP/1.1 200 Connection Established` first, then the real response -- so
    naively grepping the whole dump can read the proxy's headers instead of
    GitHub's.
    """
    blocks = [b for b in re.split(r"\r?\n\r?\n", raw_head) if b.strip()]
    return blocks[-1] if blocks else ""


def header_value(raw_head, name):
    m = re.search(rf"^{re.escape(name)}:\s*(.*)$", raw_head, re.I | re.M)
    return m.group(1).strip() if m else ""


def next_link(raw_head):
    m = re.search(r'<([^>]+)>;\s*rel="next"', header_value(raw_head, "link"))
    return m.group(1) if m else None


def emit(payload, jq_expr):
    text = payload if isinstance(payload, str) else json.dumps(payload, indent=2)
    if not jq_expr:
        print(text)
        return
    try:
        p = subprocess.run(["jq", "-r", jq_expr], input=text,
                           capture_output=True, text=True)
    except FileNotFoundError:
        die("--jq needs the `jq` binary on PATH")
    if p.returncode:
        die(f"jq failed: {p.stderr.strip()}")
    print(p.stdout, end="")


def auth_status():
    """Stand-in for `gh auth status`, which can't run in the sandbox.

    Worth having beyond convenience: the real `gh auth status` reports the
    sandbox's TLS failure as "The token in GITHUB_TOKEN is invalid", so the one
    command you'd reach for to check your credentials is the one that lies about
    them. This answers the actual question -- is the token good, and what can it
    do -- and names the real reason `gh` is failing.
    """
    src = "GITHUB_TOKEN" if os.environ.get("GITHUB_TOKEN") else "GH_TOKEN"
    text, head = request(f"{API}/user", "GET", {}, None)
    login = json.loads(text).get("login", "?")
    scopes = header_value(head, "x-oauth-scopes") or "(none)"
    expiry = header_value(head, "github-authentication-token-expiration")

    # Rate limit is a nicety; never let it turn a working auth check into a
    # traceback if the endpoint returns something unexpected.
    try:
        rate, _ = request(f"{API}/rate_limit", "GET", {}, None)
        core = json.loads(rate)["resources"]["core"]
        limit = f"{core['remaining']}/{core['limit']}"
    except (ValueError, KeyError, TypeError):
        limit = None

    print("github.com")
    print(f"  ✓ Logged in to github.com as {login} ({src})")
    print(f"  - Token scopes: {scopes}")
    if expiry:
        print(f"  - Token expires: {expiry}")
    if limit:
        print(f"  - API rate limit: {limit}")
    print()
    print("  Note: `gh` itself cannot reach GitHub inside the sandbox -- Go's TLS")
    print("  verifier needs trustd, which Seatbelt denies. `gh auth status` blames")
    print("  the token for that; as shown above, the token is fine.")


def main():
    argv = sys.argv[1:]
    if argv[:2] == ["auth", "status"]:
        auth_status()
        return
    if argv[:1] == ["auth"]:
        die("only `ghapi auth status` is implemented "
            "(login/logout: set GITHUB_TOKEN in your shell profile)")

    a = parse_args(argv)

    if a["endpoint"] == "graphql":
        fields = a["fields"]
        query = fields.pop("query", None)
        if not query and not a["body"]:
            die("graphql needs -f query='...' or --input")
        body = a["body"] or json.dumps({"query": query, "variables": fields})
        text, _ = request(f"{API}/graphql", "POST", a["headers"], body.encode())
        parsed = json.loads(text)
        if "errors" in parsed:
            die("graphql errors:\n" + json.dumps(parsed["errors"], indent=2))
        emit(parsed, a["jq"])
        return

    body = a["body"].encode() if a["body"] else (
        json.dumps(a["fields"]).encode() if a["fields"] else None)
    method = a["method"] or ("POST" if body else "GET")
    url = build_url(a["endpoint"])

    if not a["paginate"]:
        text, head = request(url, method, a["headers"], body)
        if a["include"]:
            print(head.strip())
            print()
        emit(text, a["jq"])
        return

    # Merge pages: bare arrays concatenate, search-style {items:[...]} merges on
    # items, anything else can't be merged so the first page is returned as-is.
    merged, container = [], None
    while url:
        text, head = request(url, method, a["headers"], body)
        page = json.loads(text)
        if isinstance(page, list):
            merged.extend(page)
        elif isinstance(page, dict) and isinstance(page.get("items"), list):
            container = container or page
            merged.extend(page["items"])
        else:
            emit(text, a["jq"])
            return
        url = next_link(head)
    if container is not None:
        container["items"] = merged
        emit(container, a["jq"])
    else:
        emit(merged, a["jq"])


if __name__ == "__main__":
    main()
